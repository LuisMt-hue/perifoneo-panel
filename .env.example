# URL base de la API y WebSocket de Traccar (o proxy local)
# En desarrollo local: http://localhost:8082
# En producción o staging: https://traccar.tu-dominio.com
VITE_TRACCAR_URL=http://localhost:8082

# Token de autenticación de Traccar (opcional)
# Si no se define, se utilizará la sesión iniciada a través del formulario de Login (/login)
VITE_TRACCAR_TOKEN=
